{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secure-cpg-demo",
	"main": "./src/index.js",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "CPG_DATA",
			"bucket_name": "secure-cpg-data"
		}
	],
	"vars": {
		"AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/3f1ba70bb65760f27b93f315a125f388/ebe-marketing-ai/anthropic"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "secure_cpg_marketing",
			"database_name": "secure-cpg-marketing",
			"database_id": "688432f7-5e21-46b6-bc72-4abe0b8119e1"
		},
		{
			"binding": "secure_cpg_reviews",
			"database_name": "secure-cpg-reviews",
			"database_id": "2122fe8e-4676-4a95-bbe5-d32bc7de668d"
		},
		{
			"binding": "instacart_data",
			"database_name": "instacart-data",
			"database_id": "6515182d-1072-4df0-b023-368fb722ac18"
		},
		{
			"binding": "ebe_bc_database",
			"database_name": "ebe-bc-database",
			"database_id": "6614b57f-4df1-492c-86fe-b4f4f01dde1a"
		}
	]
}